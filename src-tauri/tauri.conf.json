{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earshot",
  "mainBinaryName": "Earshot",
  "version": "1.0.0",
  "identifier": "com.earshot.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Earshot",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Footstep equalizer for FPS games",
    "publisher": "Earshot contributors"
  }
}
